 "repair_of": "DATA-7C-B-PREP",
 "repairs": {
  "F1": {
   "defect": "bit order reversed and the logical 1 used as a volt",
   "repair": "value=int(code,2), pam0=bit0 weight 1, pam1=bit1 weight 2, pam2=bit2 weight 4, level = bit x units.logic_high_V (1.8 V), one rule shared by DC and transient",
   "reviewer_fact": "dc_code_mismatches=4, nonrail_highs=12 at 1.0 V"
  },
  "F2": {
   "defect": "PAM ramped across the emission window, off windows written backwards, the table edge and the generated edge two numbers, leakage windows containing the next rise",
   "repair": "hold the old code then a 2 ns edge with both endpoints inside a fully-low DATA_EN region; pure-off preparation ends at 1000 ns, Emax=50 ns half-edge, one uniform transient offset of 1050 ns; five windows named apart (emission, emission_flat, off_tail, pure_off, leak_last100) and a configuration that puts leakage over an edge is refused, never truncated",
   "reviewer_fact": "PAM_ramps_over_emission_count=36, backwards_off_windows=20, enable_50_percent_errors=4, leakage_windows_with_next_enable=20"
  },
  "F3": {
   "defect": "every window refused its edges, one leakage window reused for all tails, missing context compared as equal, charge_errors and sign_check never called",
   "repair": "per-window 50% hints with the window own half-edge as the search radius and a named refusal when no bracketing pair exists; full-enable Q beside the flat mean with Qpos/signed Qneg/|Qneg| and the identity checked; sign_check and charge_errors actually called; k-th emission paired with k-th tail; settling against that window deadline; convergence validates context, finiteness and window order before comparing and keeps the absolute difference beside the QLSB ratio",
   "reviewer_fact": "8 windows NO_REAL_EDGE_FOUND, reused interval 2400000-2500000 ps at 0 A against an independent ABOVE_LIMIT 5e-06, missing_pair_context_still_accepted=true"
  },
  "F4": {
   "defect": "no deck stated its temperature, the analysis lines were unnamed",
   "repair": "simopt options temp=27, dc_case dc dev=Vclamp param=dc start=0.600 stop=1.500 step=0.050, <instance> tran stop=<absolute> maxstep=<case>, and vsource type=pwl wave=[t v ...]; the audit parses effective statements, not lines containing a word",
   "reviewer_fact": "no_explicit_27C=15, unnamed_analysis_lines=15"
  }
 },
