// TR-IDENTITY: geometry_body_and_reference_unchanged=YES
// TR-IDENTITY: pdk_library_and_schematic_untouched=YES
// TR-IDENTITY: this_copy_runs=YES: the approved DATA-7C-B-TR accounts this case against the limit of 24 processes, so an inherited TEXT ONLY banner in the frozen first line describes the preparation round only
//
// Generated by scripts/dd1_d7c_b_prep_deckgen.py from tests/dd1_d7c_b_prep/contract.json and
// tests/dd1_d7c_b_prep/schedule.csv. Do not edit this file by hand: change the source and
// regenerate, otherwise the schedule and the deck disagree, which is the defect this round
// exists to remove. Contract state: PROPOSED_FOR_REVIEW (not USER_APPROVED).
// Authorisation: NEW_SPECTRE_LAUNCH_LIMIT=0, NATIVE_PREFLIGHT_AUTHORISED=NO,
// NEXT_NATIVE_STAGE_AUTHORISED=NO. Nothing in this file has been run, and running it is not
// authorised by this round. NATIVE_NETLIST_SYNTAX=NOT_VERIFIED: the analysis and pwl forms
// below are the ones this project has already run (scripts/dd1_d7b_run.py:239 and :288,
// spectre/current_probe_syntax.scs:35), but hierarchical saves are still unproven on them.
//
// ---- this case, in numbers -------------------------------------------------------
// class                 : transient
// pam_sel               : 000  (pam0=bit0 weight 1, pam1=bit1 weight 2, pam2=bit2 weight 4)
// DATA_EN form          : pwl_single_platform at 1.800 V (the 1.800 V logic domain, never the bit itself)
// temperature           : simopt options temp=27, written as a statement in this deck
// supplies              : vdd18=1.8 V, vcas=1.8 V, vss=explicit 0 V source, Iref=1.5e-05 A (the deck writes it as 15u)
// output clamp          : 1.2 V (POC condition, not VLED, not VSCAN, not SOA)
// pure-off preparation: ends at 1000.000 ns; offset applied to every instant of this case: 1050.000 ns; half-edge 10.000 ns
// platform (rise50/fall50): 1170.000 / 1370.000
// ramp endpoints      : rise 1160.000->1180.000, fall 1360.000->1380.000
// full-enable window  : 1170.000 -> 1370.000 (rise50 to fall50; the charge convergence compares)
// flat part           : 1180.000 -> 1360.000 (the mean current and the sign rule)
// tail charge window  : 1370.000 -> 1610.000
// pure-off window     : 1380.000 -> 1610.000 (DATA_EN is 0 V across all of it)
// leakage sub-window  : 1510.000-1610.000 (criterion: max(abs(I_sink)) <= 1.5e-07 A, the deck spells it 150n)
// code change rule    : the code is static from t=0 and settled 1160.000 ns before the only rising edge; the R2 relative 120 ns start interval is kept and shifted by the same 1050 ns [two pulses per 200 ns slot at the Hybrid 60 Hz pitch]
// settled before edge : 1160.000 ns
// stop / maxstep      : 1610.000 ns / 2.000 ns
// analysis            : tran_case tran stop=1610.000n maxstep=2.000n
// launch plan         : 1 DUT process + 1 preflight process
// windows declared for this case: TR-200#F0, TR-200#L0, TR-200#O0, TR-200#T0, TR-200#W0
//
// ---- probe and sign, fixed before any run -------------------------------------------------
// Ip_branch (clamp_node data_out) iprobe, so a positive reading IS the selected branches
// sinking current out of data_out: I_sink = Ip_branch, with no negation and no abs(). The
// physical positive path is clamp_node -> data_out -> the conducting branch(es) -> vss, which
// is the same terminal order the accepted DATA-7B bench uses. A shutoff tail keeps its own
// sign: Q, Qpos and the magnitude of Qneg are reported separately and never cancel.
simulator lang=spectre insensitive=yes

// PDK path and model section come from the environment; no model card is copied into this
// repository and none was read this round.
include "${QODER_PDK_LIB}" section=tt
// the temperature is a deck condition, not a contract adjective
simopt options temp=27

include "${QODER_NETLIST_DIR}/dd1_d6_inv18.scs"
include "${QODER_NETLIST_DIR}/dd1_d6_bias_core.scs"
include "${QODER_NETLIST_DIR}/dd1_d7c_a_gates.scs"
include "${QODER_NETLIST_DIR}/dd1_d7c_a_pam_dec.scs"
include "${QODER_NETLIST_DIR}/dd1_d7c_a_sink_unit.scs"
include "${QODER_NETLIST_DIR}/dd1_d7c_a_pam_top.scs"

// ---- the device under test: one output, eight selectable branches (delivered, unmodified)
Rload_meter (data_out vss) resistor r=80e3
Rref_meter (iref_in vss) resistor r=50e3

// ---- testbench side: reference and supplies, every node referenced to a real 0 V
Iref_in (irefbus iref_in) isource dc=15u
Viref (irefbus 0) vsource dc=0
Vdd18 (vdd18 0) vsource dc=1.8
Vss (vss 0) vsource dc=0
Vcas (vcas 0) vsource dc=1.8
Vclamp (clamp_node 0) vsource dc=1.2
// Finite-slope enable as absolute times, low at t=0 and with no extra point inside a
// ramp, so the interpolated 50% crossing is the edge the schedule declares. Envelope
// 0.000 ns .. 1610.000 ns (7 points).
Vdata_en (data_en 0) vsource type=pwl wave=[0n 0.000 1000n 0.000 1160n 0.000 1180n 1.800 1360n 1.800 1380n 0.000 1610n 0.000]
VPAM0 (pam0 0) vsource dc=0.000   // static from t=0, settled before the first edge
VPAM1 (pam1 0) vsource dc=0.000   // static from t=0, settled before the first edge
VPAM2 (pam2 0) vsource dc=0.000   // static from t=0, settled before the first edge
// A second analysis form is deliberately absent: this deck declares one tran line, so a
// reviewer can tell which stop and maxstep the case was planned with.

// ---- observation points. Hierarchical saves are NOT_VERIFIED on this build; if the native
// stage refuses them the fallback is to lift the node in a draft copy of the unit subckt,
// never to edit the delivered candidate.
Ip_branch (clamp_node data_out) iprobe
save vdd18 vss iref_in vcas data_out clamp_node irefbus data_en pam0 pam1 pam2
save Ip_branch Ip_branch:current

tran_case tran stop=1610.000n maxstep=2.000n

// result column for this case in tests/dd1_d7c_b_prep/schedule.csv: NOT_RUN
