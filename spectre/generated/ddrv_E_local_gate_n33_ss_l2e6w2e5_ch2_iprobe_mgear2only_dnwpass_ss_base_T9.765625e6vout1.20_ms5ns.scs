// ddrv_E_local_gate_tran -- generated by scripts/ddrv_gen.py (2 channel(s)).
// Accepted core, unchanged: Mout + Mcas, n33, W=2e-5 L=2e-6, cascode gate at 1.8 V.
// Rework under test: each channel owns its mirror gate node `vbias_ch`. DATA_EN drives a
// local pass device to VBIAS_SHARED; DATA_EN_B drives a local bleed to VSS. No channel can
// bleed the shared node -- that was the fatal property of the shared-gate structure (C) and
// the residual dynamic coupling of the cascode-gate variant (D).
// Direction: low-side SINK to VSS (ENGINEERING_TOPOLOGY_CHOICE). Vf / VLED: NOT DEFINED, so
// V(DATA_OUT) stays a swept test variable and no LED model is invented here.
// ideal IREF / VCAS / DATA_EN / DATA_EN_B: TESTBENCH ASSUMPTIONS (POC_ASSUMPTION).
simulator lang=spectre insensitive=yes

include "${QODER_PDK_LIB}" section=ss

parameters IREF=15u VDDV=1.8 VCASV=1.8

* ---- shared bias: always on, never bled by any channel ------------------------
Mref (vbias vbias vss vss) n33 l=2e-6 w=2e-5
Iref (vdd vbias) isource dc=IREF


* `vss` tied to the Spectre reference node 0 on purpose (AGENTS item 19).
Vdd (vdd 0) vsource dc=VDDV
Vss (vss 0) vsource dc=0

* ---- channel 0: 2 core MOS + 2 local gate-control MOS ----------------------
Mcas   (data_out vcas   node_m vss) n33      l=2e-6  w=2e-5
Mout   (node_m  vbias_ch   vss      vss) n33      l=2e-6  w=2e-5
* E-DNW: the pass device is a deep-N-well master, so vbias_ch really is this channel's own
* isolated body and tying it to the source (VBS = 0) is manufacturable
Mpass_local   (vbias   data_en   vbias_ch vbias_ch) n33_dnw_4t_ckt l=2e-6 w=5e-6
Mbleed_local (vbias_ch data_en_b vss   vss)  n33  l=2e-6 w=2e-6
Vcas  (vcas  0) vsource dc=VCASV
Vout  (vsw   0) vsource dc=1.20
Ip1 (vsw data_out) iprobe

* ---- channel 1: 2 core MOS + 2 local gate-control MOS ----------------------
Mcas1   (data_out1 vcas1   node_m1 vss) n33      l=2e-6  w=2e-5
Mout1   (node_m1  vbias_ch1   vss      vss) n33      l=2e-6  w=2e-5
* E-DNW: the pass device is a deep-N-well master, so vbias_ch1 really is this channel's own
* isolated body and tying it to the source (VBS = 0) is manufacturable
Mpass_local1   (vbias   data_en1   vbias_ch1 vbias_ch1) n33_dnw_4t_ckt l=2e-6 w=5e-6
Mbleed_local1 (vbias_ch1 data_en_b1 vss   vss)  n33  l=2e-6 w=2e-6
Vcas1  (vcas1  0) vsource dc=VCASV
Vout1  (vsw1   0) vsource dc=1.20
Ip2 (vsw1 data_out1) iprobe

save Ip1:i Ip2:i
save Mout:1 Mout1:1

save vdd vss vbias vsw data_out node_m vbias_ch data_en data_en_b vcas vsw1 data_out1 node_m1 vbias_ch1 data_en1 data_en_b1 vcas1

parameters TD=9.765625e-6
Vde (data_en 0) vsource dc=VDDV
Vdeb (data_en_b 0) vsource dc=0
Vde1 (data_en1 0) vsource dc=VDDV
Vdeb1 (data_en_b1 0) vsource dc=0

tran1 tran stop=4.39453e-05 step=4.88281e-09 maxstep=5e-09 method=gear2only
