# Local PDK paths -- copy to pdk_local.env (same directory) and fill in YOUR paths.
#
#   cp spectre/pdk_local.env.example spectre/pdk_local.env
#
# pdk_local.env is git-ignored on purpose. Committed netlists reference these
# variables as ${...} inside `include`, which Spectre expands from the environment, so
# no foundry/instructor model file, path or deck is ever stored in this repository.
# run_spectre.sh sources this file automatically and refuses to run if a netlist needs
# a variable that is not set.
#
# The values below are the layout used on the RHEL6 + IC617 guest of this project; on
# another machine point them at your own installed PDK model libraries.

# SMIC 018 MM RF, 1.8 V core + 3.3 V I/O -- the process fixed by the course instructor.
# Point at the Spectre include file that carries the model sections (tt/ff/ss/...).
export QODER_PDK_LIB=/path/to/<instructor-pdk>/models/spectre/<model-include>

# Used only by the historical read-only PDK probes (spectre/model_probe_*).
export QODER_SMIC18EE_LIB=/path/to/<smic18ee-pdk>/models/spectre/<model-include>
export QODER_TSMC18_MODEL=/path/to/<tsmc18-pdk>/models/spectre/<model-card>
export QODER_TSMC18_MASTER=/path/to/<tsmc18-pdk>/models/spectre/<master-include>

# Read-only inventory root that holds installed PDKs (scripts/pdk_model_probe.sh).
export QODER_TECH_ROOT=/path/to/installed/pdks
